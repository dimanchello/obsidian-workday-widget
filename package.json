{
    "name": "obsidian-workday-widget",
    "version": "3.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "node esbuild.config.mjs production",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"src/**/*.{ts,js}\" \"*.{js,mjs,json}\"",
        "format:check": "prettier --check \"src/**/*.{ts,js}\" \"*.{js,mjs,json}\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "knip": "knip",
        "validate": "npm run typecheck && npm run lint && npm run knip && npm run format:check && npm run test"
    },
    "dependencies": {
        "obsidian": "latest"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^18.0.0",
        "builtin-modules": "^3.3.0",
        "esbuild": "0.25.0",
        "eslint": "^10.4.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "globals": "^17.6.0",
        "knip": "^6.14.2",
        "prettier": "^3.8.3",
        "typescript": "^5.0.0",
        "typescript-eslint": "^8.59.3",
        "vitest": "^4.1.6"
    },
    "knip": {
        "rules": {
            "types": "off"
        }
    }
}
