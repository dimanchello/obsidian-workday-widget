{
    "compilerOptions": {
        "baseUrl": ".",
        "inlineSourceMap": true,
        "inlineSources": true,
        "module": "ESNext",
        "target": "ES2018",
        "allowSyntheticDefaultImports": true,
        "moduleResolution": "bundler",
        "importHelpers": false,
        "strict": true,
        "skipLibCheck": true,
        "outDir": "dist",
        "paths": {
            "obsidian": ["node_modules/obsidian/obsidian.d.ts"]
        }
    },
    "include": ["src/**/*.ts"]
}
